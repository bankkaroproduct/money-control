# Moneycontrol Brand Configuration
# Copy these values to Vercel Environment Variables

NEXT_PUBLIC_BRAND_NAME=Moneycontrol
NEXT_PUBLIC_BRAND_TAGLINE=Smart Credit Card Decisions
NEXT_PUBLIC_BRAND_LOGO=/moneycontrol-logo.svg
NEXT_PUBLIC_BRAND_FAVICON=/favicon.png
NEXT_PUBLIC_BRAND_EMAIL=support@moneycontrol.com

# Moneycontrol Brand Blue (#1A6DA4)
NEXT_PUBLIC_PRIMARY_COLOR=#1A6DA4

# Moneycontrol Brand Green (#5BA42B)
NEXT_PUBLIC_SECONDARY_COLOR=#52B974

# Dark navy header
NEXT_PUBLIC_HEADER_BG_COLOR=#0e2230

# App URL
NEXT_PUBLIC_APP_URL=https://money-control-beryl.vercel.app

# ============================================
# PARTNER API (CRITICAL FOR ATTRIBUTION)
# ============================================
PARTNER_API_KEY=YOUR_MONEYCONTROL_API_KEY_HERE
PARTNER_TOKEN_URL=https://platform.bankkaro.com/partner/token
PARTNER_BASE_URL=https://platform.bankkaro.com/partner
